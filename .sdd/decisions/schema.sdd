# Decision Schema
Purpose:
  Decision Schema


Decision:
  id: DEC-<ID>
  type: architectural|technical|security|business|operational|human|ai
  status: proposed|approved|rejected|superseded|implemented|verified

  title: <one line>
  context: <why this decision is needed>
  problem: <what problem it solves>

  options:
    - option: <alternative 1>
      pros: [..]
      cons: [..]
      cost: <estimate>
    - option: <alternative 2>
      pros: [..]
      cons: [..]
      cost: <estimate>

  decision: <chosen option>
  rationale: <why this option>

  impact:
    files: [affected paths]
    modules: [affected modules]
    risks: [R0-R5]

  owner: <human or agent id>
  reviewers: [list]
  approved_by: <who approved>
  approved_at: <timestamp>

  implementation:
    tasks: [TASK ids]
    chain: <chain type>
    status: pending|in_progress|completed

  verification:
    criteria: [how to verify]
    status: pending|passed|failed

  supersedes: <previous DEC id if any>
  conflicts: <conflicting DEC ids>
  depends_on: <prerequisite DEC ids>

   created_at: <timestamp>
   updated_at: <timestamp>

State: +

