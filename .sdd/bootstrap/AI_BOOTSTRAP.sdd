  Index: @../INDEX.sdd
  Authority: @authority.sdd
  Identity: @identity.sdd
  Handoff: @handoff.sdd
  Glossary: @../glossary/INDEX.sdd
  ContextCompiler: @../system/context/INDEX.sdd
  Governance: @../governance/INDEX.sdd
  Capabilities: @../governance/capabilities.sdd
  Permissions: @../governance/permissions.sdd
  Locks: @../governance/locks.sdd
  SecurityEvents: @../governance/security-events.sdd
  Lifecycle: @../lifecycle/INDEX.sdd
  Assumptions: @../assumptions/INDEX.sdd
  Tasks: @../tasks/INDEX.sdd
  Project: @../project/INDEX.sdd

