  MemoryModel: @../../runtime/memory-model.sdd
  ResearchArm: @../../chains/arms/research.sdd
  RuntimeState: @../../runtime/state.sdd
  MCPAllowlist: @../../runtime/mcp-allowlist.sdd
  WeakPointMap: @../../agent/weak-point-map.sdd

