# SDDRA Backend Builder
# Builds and runs backend services (Node, Python, Go, Java, .NET)
# Args:
#   RUNTIME: node (default) | python | go | java | dotnet
# Rules applied: R91 (local image), R92 (var/ mounts), R102 (resource limits)

ARG NODE_IMAGE=node:26-bookworm-slim@sha256:662933cf47f013bc8e4beb31a6116448427a82057ba7c42c97e4c5ba766504c2

FROM ${NODE_IMAGE} AS builder
ARG RUNTIME=node
ENV RUNTIME=${RUNTIME}
WORKDIR /workspace

COPY .sdd/codding/be-builder/package.json ./package.json
RUN npm install --ignore-scripts 2>/dev/null || true

RUN if [ "$RUNTIME" = "node" ]; then \
      echo "Node backend builder active"; \
    elif [ "$RUNTIME" = "python" ]; then \
      echo "Python backend builder active"; \
    elif [ "$RUNTIME" = "go" ]; then \
      echo "Go backend builder active"; \
    elif [ "$RUNTIME" = "java" ]; then \
      echo "Java backend builder active"; \
    elif [ "$RUNTIME" = "dotnet" ]; then \
      echo ".NET backend builder active"; \
    else \
      echo "Unknown runtime: ${RUNTIME}"; \
    fi

FROM ${NODE_IMAGE} AS runner
WORKDIR /workspace
COPY --from=builder /workspace /workspace
EXPOSE 3000
CMD ["node", "index.js"]
