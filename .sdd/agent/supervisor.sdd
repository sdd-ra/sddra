  Roles: @roles.sdd
  Coordination: @coordination.sdd
  Handoff: @handoff.sdd
  EccBridge: @ecc-bridge.sdd
  Chains: @../chains/INDEX.sdd
  Tasks: @../tasks/INDEX.sdd
  TaskStateMachine: @../tasks/TASK-STATE-MACHINE.sdd
  Runtime: @../runtime/INDEX.sdd

