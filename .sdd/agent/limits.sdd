Limits: Agent

Purpose:
  Defines agent execution limits and constraints.

ExecutionLimits:
  MaxActionsPerRun:
    50
  MaxFileSize:
    10MB
  MaxContextTokens:
    100000
  MaxRetries:
    3
  MaxParallelTasks:
    5
  MaxRuntimePerTask:
    30 minutes

DockerExecution:
  rule: ALL execution MUST run inside Docker
  rule: no local tool installation is permitted
  rule: Docker image MUST include all required tools
  rule: network access MUST be restricted to allowlisted domains only

DockerResourceLimits:
  CPU:
    2 cores max
  Memory:
    4GB max
  Disk:
    10GB temporary
  PIDs:
    256 max
  Network:
    allowlisted domains only

DockerVolumes:
  rule: volumes MUST be read-only unless explicitly required for output
  rule: no host filesystem access outside volumes

DockerToolAccess:
  allowed:
    - docker build
    - docker run
    - docker compose
    - docker exec
    - docker cp
  denied:
    - docker run --privileged
    - docker run --network=host
    - docker run -v /:/host

ResourceLimits:
  Memory:
    512MB
  Disk:
    1GB (temporary)
  Network:
    Allowlisted domains only

Timeouts:
  ShellCommand:
    30 seconds
  TestRun:
    5 minutes
  Build:
    10 minutes
  Deployment:
    30 minutes

RateLimits:
  API Calls:
    100 per minute
  GitOperations:
    50 per minute

LimitRules:
  [LM1]  Agent MUST respect all limits.
  [LM2]  Agent MUST escalate when limits exceeded.
  [LM3]  Agent MUST NOT bypass limits for convenience.
  [LM4]  Agent MUST report limit exhaustion clearly.

State: +