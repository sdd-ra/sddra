tech_stack:
  languages:
    - go (L3-L4 microservices)
    - typescript (L3-L4 enterprise)
  frameworks:
    - go-grpc (service communication)
    - spring-boot (legacy integration)
  databases:
    - postgresql (L3-L4 enterprise)
    - redis (L1 caching)
  platforms:
    - docker (L3 kubernetes)
    - kubernetes (L1-L2)
    - terraform (L1)
    - aws (L1)
  messaging:
    - kafka (L1 event streaming)
    - rabbitmq (L1 task queues)
  cross-cutting:
    - testing: tdd, integration, performance
    - security: authentication, authorization
    - architecture: ddd, microservices, event-driven
    - observability: logging, metrics, tracing, alerting

rules:
  [M1] Each service MUST have its own database.
  [M2] Use API Gateway for external communication.
  [M3] Use async communication for inter-service calls.
  [M4] Implement circuit breakers for resilience.
  [M5] Use distributed tracing for observability.
  [M6] Implement Saga for distributed transactions.
  [M7] Use service discovery.
  [M8] Each service MUST be independently deployable.

decisions:
  - id: MIG-001
    title: Service decomposition strategy
    status: pending
    options:
      - by business capability
      - by subdomain
      - by team

  - id: MIG-002
    title: Data migration approach
    status: pending
    options:
      - strangler fig pattern
      - parallel run
      - big bang

approval_required:
  - MIG-001
  - MIG-002

provisioning:
