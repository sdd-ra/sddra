# Arm: Deploy

Purpose:
  Production deployment after approval. Minimal tokens.

Owns: chains\arms\deploy.sdd
Stage:
  id: DEP1
  name: deploy
  inputs:
    - project/
    - approval
  outputs:
    - production
  skills:
    - prompts/provisioning/INDEX.sdd
  token:
    - ../../projects/{project_name}/tokens/DEP1.sdd
  gate:
     - human

State: +
