# Arm: Prompt

Purpose:
  Parse human prompt -> docs/. Minimal tokens.

Owns: chains\arms\prompt.sdd
Stage:
  id: P1
  name: prompt
  inputs:
    - prompt
  outputs:
    - docs/00-about/project.md
    - docs/20-architecture/overview.md
  skills:
    - prompts/tech-stack/prompt-to-docs.sdd
    - plugins/plugin-adapters/brainstorming.sdd
  token:
    - ../../projects/{project_name}/tokens/P1.sdd
  gate:
     - human

State: +
