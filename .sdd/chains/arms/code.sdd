# Arm: Code

Purpose:
  Execute .sdd/project/ tasks to code. Minimal tokens.

Owns: chains\arms\code.sdd
Stage:
  id: C1
  name: code
  inputs:
    - .sdd/project/
    - .sdd/projects/{project_name}/decisions/ (approved decisions)
  outputs:
    - project/
    - .sdd/projects/{project_name}/decisions/DEC-XXX.sdd (updated status)
  skills:
    - workflow/impl-task-execution.sdd
    - plugins/plugin-adapters/using-git-worktrees.sdd
  token:
    - ../../projects/{project_name}/tokens/C1.sdd
  decision:
    - Implement tasks linked to approved decisions
    - Update decision status to implemented
  gate:
     - human_review

State: +
