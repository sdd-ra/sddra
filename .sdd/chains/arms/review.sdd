# Arm: Review

Purpose:
  Human review gate after code execution. Minimal tokens.

Parent: D0
Returns: D0

Stage:
  id: R1
  name: review
  parent: D0
  returns_to: D0
  inputs:
    - project/
  outputs:
    - approval|rejection
  skills:
    - prompts/role-assignment/human-in-the-loop.sdd
    - plugins/plugin-adapters/code-review.sdd
    - plugins/plugin-adapters/verification-before-completion.sdd
  token:
    - ../../projects/example_project/tokens/R1.sdd
  rule:
    - ./rules/INDEX.sdd
  gate:
     - human

State: +

