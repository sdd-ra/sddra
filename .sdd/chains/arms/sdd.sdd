# Arm: SDD

Purpose:
  Convert approved docs/ to .sdd/project/. Minimal tokens.

Owns: chains\arms\sdd.sdd
Stage:
  id: S1
  name: sdd
  inputs:
    - docs/
    - .sdd/projects/{project_name}/decisions/ (approved decisions)
  outputs:
    - .sdd/project/schema.sdd
    - .sdd/project/domains.sdd
    - .sdd/projects/{project_name}/tasks/INDEX.sdd
    - .sdd/projects/{project_name}/tasks/TASK-XXX.sdd (linked to decisions)
  skills:
    - prompts/tech-stack/docs-to-project.sdd
    - plugins/plugin-adapters/writing-plans.sdd
  token:
    - ../../projects/{project_name}/tokens/S1.sdd
  decision:
    - Reference approved decisions from D1
    - Create tasks linked to decision IDs
  gate:
     - human

State: +
