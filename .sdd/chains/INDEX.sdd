Chains: Index

Purpose:
  Execution chains. Root D0 branches to arms; arms return to D0.
  Every execution path is a branch of default.

Graph:
  root: D0
  arms: P1,D1,S1,C1,R1,DEP1,RS1
  selector: @selector.sdd
  rules: @rules/chain-rules.sdd

Files:
  default: @default.sdd
  selector: @selector.sdd
  feature: @feature.sdd
  bugfix: @bugfix.sdd
  hotfix: @hotfix.sdd
  refactor: @refactor.sdd
  security: @security.sdd
  maintenance: @maintenance.sdd
  migration: @migration.sdd
  incident: @incident.sdd
  delivery: @delivery.sdd

Arms:
  prompt: @arms/prompt.sdd
  docs: @arms/docs.sdd
  sdd: @arms/sdd.sdd
  code: @arms/code.sdd
  review: @arms/review.sdd
  deploy: @arms/deploy.sdd
  research: @arms/research.sdd

Rules:
  chain: @rules/chain-rules.sdd

State: +
