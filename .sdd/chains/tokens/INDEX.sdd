# Token Tracking

Purpose:
  Record token usage per chain stage for cost control.

Schema: @calculator.sdd

Index:
  P1: @projects/{project_name}/tokens/P1.sdd
  D1: @projects/{project_name}/tokens/D1.sdd
  S1: @projects/{project_name}/tokens/S1.sdd
  C1: @projects/{project_name}/tokens/C1.sdd
  R1: @projects/{project_name}/tokens/R1.sdd
  DEP1: @projects/{project_name}/tokens/DEP1.sdd
  D0: @projects/{project_name}/tokens/D0.sdd

State: +