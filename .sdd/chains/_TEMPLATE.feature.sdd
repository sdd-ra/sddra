Feature: <FeatureName>

Chain:
  AN > AR > DB > BE > API > FE > MD > QA > DO > VR

  # Abbreviation table + optional-stage mechanism: protocol/stages.sdd
  # This is the Execution Chain only. Do not put the Dependency Graph or
  # the Skill Chain in this block — see protocol/stages.sdd -> ThreeRelations.

RequiredStages:
  # Not every feature needs the full pipeline — declare only what applies.
  # Example (backend-only bugfix): BE, QA, VR
  # Example (UI-only change):      FE, MD, QA, VR
  # Example (infra-only change):   DO, VR
  BE
  FE
  MD
  QA
  DO
  VR

Stages:

  DB {
    optional
    condition: database-impact = true
  }

  BE {
    input:
      requirement
      architecture
      domain-model
    output:
      code
      api-contract
      tests
    validate:
      build
      unit-test
      architecture-check
    skills:
      .sdd/backend/architecture
      .sdd/backend/ddd
      .sdd/backend/clean-code
      .sdd/backend/testing
    next: FE
    fail: CODE
  }

  FE {
    input:
      api-contract
    output:
      UI
      frontend-tests
    validate:
      build
      tests
      contract-check
    skills:
      .sdd/frontend/architecture
      .sdd/frontend/components
      .sdd/frontend/accessibility
    next: MD
    fail: FE
  }

  MD {
    input:
      api-contract
    output:
      mobile-screens
      mobile-tests
    validate:
      build
      tests
      contract-check
    skills:
      .sdd/mobile/architecture
      .sdd/mobile/api
      .sdd/mobile/testing
    next: QA
    fail: MD
  }

  QA {
    input:
      BE
      FE
      MD
    output:
      test-report
    validate:
      BDD
      integration
      regression
    skills:
      .sdd/qa/bdd
      .sdd/qa/integration
      .sdd/qa/regression
    next: DO
    fail: responsible-stage   # routed by reason, see protocol/rules.sdd
  }

  DO {
    input:
      QA+
    output:
      deployment
    validate:
      pipeline
    skills:
      .sdd/devops/docker
      .sdd/devops/ci-cd
      .sdd/devops/observability
    next: VR
    fail: DO
  }

State:
  AN ?, AR ?, DB ?, BE ?, API ?, FE ?, MD ?, QA ?, DO ?, VR ?
  # update in place as the chain progresses, e.g.: + BE, ~ FE, ? QA

Note:
  This is a template — copy to .sdd/chains/<feature>.feature.sdd per real
  feature and fill in RequiredStages + State. Do not execute this file
  directly (see protocol/rules.sdd -> "A chain node without
  input/output/validate/next/fail is considered invalid").
