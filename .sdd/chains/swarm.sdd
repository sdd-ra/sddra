  StepKeys: @../workflow/step-keys.sdd
  Stages: @../workflow/stages.sdd
  MicroUnit: @../workflow/micro-unit.sdd
  MicroUnitSchema: @../schemas/micro-unit.sdd
  SubAgentLifecycle: @../agent/subagent-lifecycle.sdd
  DispatchChannels: @../workflow/dispatch-channels.sdd
  Supervisor: @../agent/supervisor.sdd
  Handoff: @../agent/handoff.sdd
  LoopProtection: @../tasks/LOOP-PROTECTION.sdd
  ExecutionLoop: @../workflow/execution-loop.sdd
  ReleaseGate: @../gates/release.sdd
  NextCommand: @../commands/sdd-swarm.sdd
  DeliveryChain: @delivery.sdd

State: +
  (Phase 160 — created per DEC-2026-1011-001 D1; separate from the
   immutable DL1 delivery chain; 16-stage macro pipeline with
   per-stage SWARM cycle and defect-focus loop)
  (Phase 161 — extended per DEC-2026-1011-002: RECONCILE step 0,
   dual dispatch channels (R ordered / F free, within-stage only),
   recursive sub-agent pyramid with depth cap 2, DEC->TASK->SUBTASK
   close ladder, and [SW1-9]-[SW1-14])