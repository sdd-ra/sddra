{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["*.ts", "security/*.ts", "drift-detector.ts", "sync-engine.ts", "trace-engine.ts", "evidence-binder.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
