# SDDRA Mobile Build Simulator
# Simulates React Native / Flutter mobile build inside Docker
# Generates mock APK/IPA artifacts for SDDRA chain simulation
# Rules applied: R91 (local image), R92 (var/ mounts), R102 (resource limits)

ARG NODE_IMAGE=node:26-bookworm-slim@sha256:662933cf47f013bc8e4beb31a6116448427a82057ba7c42c97e4c5ba766504c2

FROM ${NODE_IMAGE} AS builder
WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jdk-headless python3 zip unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/src

COPY mobile-builder/package.json ./
RUN npm ci --ignore-scripts 2>/dev/null || npm install --ignore-scripts

COPY mobile-builder/ ./

RUN mkdir -p output

CMD ["node", "build.js"]
