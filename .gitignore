# SDDRA .gitignore

# Old/archived files
old/

# Temporary files
tmp/
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Node modules (if any)
node_modules/

# Build outputs
dist/
build/
out/

# Logs
*.log
logs/

# Environment files
.env
.env.local
.env.*.local

# Backup files
*.bak
*.backup

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
ENV/
env/

# Go
go.sum

# Java
target/
*.class

# C#
bin/
obj/
*.exe
*.dll

# Rust
target/
Cargo.lock

# AI coding tool configs — keep product files, drop AI runtime state [R97][R103]
.claude/*
!.claude/sdd/
.claude/sdd/*
!.claude/sdd/workflow.yaml
!.claude/sdd/orchestrator.md
!.claude/commands/
!.claude/commands/**
!.claude/docs/
!.claude/docs/**

# .kilo — track commands/skills/config (product), ignore runtime state [R98]
.kilo/*
!.kilo/command/
!.kilo/command/**
!.kilo/skills/
!.kilo/skills/**
!.kilo/scripts/
!.kilo/scripts/**
!.kilo/setup-script.ps1
!.kilo/run-script.ps1
!.kilo/kilo.jsonc
!.kilo/.gitignore

# Docker bind-mount root [R92]
var/

# Prompt inbox (runtime artifacts)
prompts/inbox/

# General
*.pid
*.seed
*.pid.lock
